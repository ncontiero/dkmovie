{
  "name": "dkmovie",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "A Django project of films and series.",
  "author": "Nicolas Contiero",
  "license": "MIT",
  "scripts": {
    "build": "rspack build -c rspack/prod.config.ts",
    "build:email": "pnpm --filter=@dkmovie/emails run export",
    "dev": "rspack serve -c rspack/dev.config.ts",
    "dev:email": "pnpm --filter=@dkmovie/emails run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@ncontiero/eslint-config": "6.4.1",
    "@rspack/cli": "^1.6.3",
    "@rspack/core": "^1.6.3",
    "@rspack/plugin-react-refresh": "^1.5.3",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "react-refresh": "^0.18.0",
    "tailwindcss": "4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack-bundle-tracker": "^3.2.2",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=22.16"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
