{
  "name": "dkmovie",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Full-stack video streaming platform.",
  "author": "Nicolas Contiero",
  "license": "MIT",
  "scripts": {
    "build": "rspack build -c rspack/prod.config.ts",
