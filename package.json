    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-player": "3.4.0",
    "react-qr-code": "2.2.0",
