    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "filepond": "4.32.12",
    "input-otp": "1.4.2",
    "lucide-react": "1.28.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-player": "3.4.0",
    "react-qr-code": "2.2.0",
    "sonner": "2.0.7",
    "swiper": "14.0.7",
